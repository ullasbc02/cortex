<div class="container">
  <%# <h1 class="card-title">Search</h1> %>
  <div class="flex justify-end mb-4">
    <%= button_to "Add Document", new_document_path, method: :get, class: "btn btn-primary" %>
  </div>
  <%= form_with url: search_path, method: :get, local: true do %>
    <div>
      <%= label_tag :q, "Query", class: "form-label" %>
      <%= text_field_tag :q, params[:q], placeholder: "Enter your query", class: "form-input" %>
    </div>
    <br>
    <%= submit_tag "Search", class: "btn btn-primary" %>
  <% end %>
<br>
  <% if @query.present? %>
    <% if @answer.present? %>
      <div>
        <h2 class="card-title">Answer</h2>
        <div class="card">
          <div class="card-content"><%= simple_format(@answer) %></div>
        </div>
      </div>
    <% end %>

    <div>
      <h2 class="card-title">Sources</h2>
      <% if @chunks.present? %>
        <ul>
          <% @chunks.each do |c| %>
            <li class="card">
              <div class="card-meta">Document: <%= c.document_id %> • Position: <%= c.position %> • Distance: <%= c.distance.round(3) %></div>
              <div class="card-content"><%= c.content %></div>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="card-meta">No results.</p>
      <% end %>
    </div>
  <% end %>
</div>
