<%= button_to "Search", search_path, method: :get, class: "btn btn-primary" %>
&nbsp;
<%= button_to "Add Document", new_document_path, method: :get, class: "btn btn-primary" %>
<br>
<% if @documents.any? %>
  <ul class="card-list">
    <% @documents.each do |doc| %>
      <li class="card">
        <h3 class="card-title"><%= doc.title %></h3>

        <p class="card-content">
          <%= truncate(doc.content, length: 500) %>
        </p>

        <div class="card-footer">
          <small class="card-meta">
            Added <%= time_ago_in_words(doc.created_at) %> ago
          </small>
          <%= button_to "Delete", document_path(doc), method: :delete, data: { confirm: "Are you sure you want to delete this document?" }, class: "btn btn-danger" %>
          <%= button_to "Edit", edit_document_path(doc), method: :get, class: "btn btn-primary" %>
        </div>

      </li>
    <% end %>
  </ul>
<% else %>
  <p>No documents yet.</p>
<% end %>
