<%# <h2>Add Document</h2> %>

<%= form_with model: @document, local: true do |f| %>
  <div>
    <%= f.label :title, class: "form-label" %><br>
    <%= f.text_field :title, class: "form-input" %>
  </div>

  <div>
    <%= f.label :content, class: "form-label" %><br>
    <%= f.text_area :content, rows: 8, class: "form-textarea" %>
  </div>

  <div>
    <%= f.submit "Save Document", class: "btn btn-primary" %>
  </div>
<% end %>