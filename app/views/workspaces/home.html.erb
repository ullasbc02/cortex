<div class="card">
	<h1>Welcome to Workspace</h1>
	<p>Write a query to get started.</p>
	<%= form_with model: @workspace, local: true do |f| %>
		<div>
			<%= f.label :Prompt, class: "form-label" %><br>
			<%= f.text_area :prompt, rows: 8, class: "form-textarea" %>
		</div>

		<div>
			<%= f.submit "Save Document", class: "btn btn-primary" %>
		</div>
	<% end %>
</div>