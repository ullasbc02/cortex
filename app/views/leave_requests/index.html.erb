<div class="card">
  <h1>Leave Requests</h1>

  <table>
    <thead>
      <tr>
        <th>Employee</th>
        <th>Period</th>
        <th>Status</th>
        <th>Days</th>
      </tr>
    </thead>
    <tbody>
      <% @leave_requests.each do |lr| %>
        <tr>
          <td><%= lr.employee_name %></td>
          <td><%= lr.start_date %> → <%= lr.end_date %></td>
          <td><%= lr.status %></td>
          <td><%= lr.duration %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= button_to "New Leave Request", leave_requests_new_path, method: :get, class: "btn btn-primary" %>
</div>
